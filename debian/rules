#!/usr/bin/make -f

# No LXD during a package build, so skip the integration tests.
export PYBUILD_TEST_ARGS = -m "not integration"
# The tests need examples/, which pybuild doesn't copy. Remove it after,
# or it gets installed into dist-packages.
export PYBUILD_BEFORE_TEST = cp -r {dir}/examples {build_dir}
export PYBUILD_AFTER_TEST = rm -rf {build_dir}/examples

%:
	dh $@ --with python3 --buildsystem=pybuild
